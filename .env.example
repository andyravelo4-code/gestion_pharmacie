# ===========================================================================
# PharmaGest — exemple de configuration d'environnement
#
# Copier ce fichier vers « .env » puis adapter les valeurs :
#     cp .env.example .env
#
# ATTENTION : config/settings.py lit les variables avec os.environ.
# Django ne charge PAS automatiquement le fichier .env. Avant de lancer une
# commande, exportez les variables dans le shell courant :
#
#     set -a; . ./.env; set +a
#
# (ou utilisez un gestionnaire de secrets / systemd EnvironmentFile en
# production). Ne versionnez jamais le fichier .env réel.
# ===========================================================================

# ---------------------------------------------------------------------------
# Sécurité Django
# ---------------------------------------------------------------------------
# Clé secrète unique et imprévisible en production. Générer par exemple avec :
#   .venv/bin/python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=django-insecure-dev-pharmagest-cle-a-remplacer-en-production-2026

# Mettre False en production (obligatoire). True uniquement en développement.
DJANGO_DEBUG=True

# Liste des domaines autorisés, séparés par des virgules (sans http://).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Origines de confiance pour les requêtes POST HTTPS (CSRF), séparées par des virgules.
# Exemple : https://pharmacie.example.mg,https://www.pharmacie.example.mg
DJANGO_CSRF_TRUSTED_ORIGINS=

# Redirection HTTPS forcée lorsque DEBUG=False.
DJANGO_SECURE_SSL_REDIRECT=True

# Durée HSTS en secondes (1 an par défaut), utilisée lorsque DEBUG=False.
DJANGO_SECURE_HSTS_SECONDS=31536000

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# « sqlite » (développement, par défaut) ou « postgresql » (production).
DATABASE_ENGINE=sqlite

# Paramètres utilisés uniquement lorsque DATABASE_ENGINE=postgresql.
# Nécessite le paquet psycopg[binary] (voir requirements.txt).
DB_NAME=pharmagest
DB_USER=pharmagest
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ---------------------------------------------------------------------------
# E-mails (réinitialisation de mot de passe, notifications)
# ---------------------------------------------------------------------------
# Par défaut, les e-mails sont affichés dans la console (développement).
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

# Exemple SMTP en production :
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.example.mg
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=notifications@example.mg
# EMAIL_HOST_PASSWORD=mot-de-passe-smtp

EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=PharmaGest <noreply@pharmagest.local>

# ---------------------------------------------------------------------------
# Rappels
# ---------------------------------------------------------------------------
# Les chemins des médias, sauvegardes et journaux sont dérivés de BASE_DIR
# dans config/settings.py :
#   MEDIA_ROOT   = <projet>/media
#   BACKUP_DIR   = <projet>/backups
#   logs         = <projet>/logs/pharmagest.log
# Ces dossiers doivent être sauvegardés et protégés en production.
